# Electricity Bill Calculator
RATE = 12.90

#Validate customer name
while True:
    name = input("Enter customer name: ")
    
    if name.strip() != "":
        break
    else:
        print("Name cannot be empty. Please try again.")
        
#Validate previous meter reading        
while True:       
    previous = float(input("Enter previous meter reading: "))
    
    if -1 < float(previous):
        break
    else:
        print("Previous meter reading should at least be zero. Please try again.")
    
    
#Validate current meter reading  
while True:
    current = float(input("Enter current meter reading: "))
    
    if previous <= float(current):
        break
    else:
        print("Current meter reading should at least be the number of previous reading. Please try again.")

consumption = current - previous
total_bill = consumption * RATE

print("\nCustomer:", name)
print("Electricity Consumption:", consumption, "kWh")
print("Total Bill: PHP", round(total_bill, 2))
